{
    "schemaVersion": 1,
    "id": "${mod_id}",
    "version": "${version}",
    "name": "${mod_name}",
    "icon": "${icon}",
    "description": "${description}",
    "authors": [
        "${mod_author}"
    ],
    "contact": {
        "homepage": "https://github.com/javiluli/Extended-Beacon-Range",
        "sources": "https://github.com/javiluli/Extended-Beacon-Range",
        "issues": "https://github.com/javiluli/Extended-Beacon-Range/issues"
    },
    "license": "${license}",
    "environment": "*",
    "entrypoints": {
        "main": [
            "com.javiluli.extendedbeaconrange.ExtendedBeaconRange"
        ],
        "modmenu": [
            "com.javiluli.extendedbeaconrange.feature.config.client.ModMenuIntegration"
        ]
    },
    "mixins": [
        "${mod_id}.mixins.json"
    ],
    "depends": {
        "fabricloader": ">=${fabric_loader_version}",
        "fabric-api": "*",
        "minecraft": "${minecraft_version}",
        "java": ">=${java_version}"
    }
}
